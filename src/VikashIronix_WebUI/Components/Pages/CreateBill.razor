@page "/billing/create"
@rendermode InteractiveServer
@using SharedKernel.DTOs.Customers
@using SharedKernel.DTOs.Inventory
@using SharedKernel.DTOs.Billing
@using VikashIronix_WebUI.Services.Customers
@using VikashIronix_WebUI.Services.Inventory
@using VikashIronix_WebUI.Services.Bills
@inject ICustomerService CustomerService
@inject IInventoryService InventoryService
@inject IBillService BillService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@using VikashIronix_WebUI.Services.Users
@inject IUserService UserService

<PageTitle>Create Invoice - Vikash Iron Management</PageTitle>

<div class="billing-root">
    <div class="main-canvas">
        <MudGrid Spacing="4">
            <!-- Left Side: Transaction Inputs -->
            <MudItem xs="12" lg="8">
                <header class="billing-header mb-4">
                    <div>
                        <MudText Typo="Typo.h5" Class="page-title">Transaction Audit</MudText>
                        <MudText Typo="Typo.caption" Class="page-subtitle">Synchronized fiscal auditing & warehouse allocation.</MudText>
                    </div>
                    <div class="header-actions">
                        @if (ActiveBillId != null)
                        {
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small" OnClose="StartNewTransaction">EDITING DRAFT: @GeneratedBillNumber</MudChip>
                        }
                        <button class="header-btn-khudra @(IsRetailMode ? "active" : "")" @onclick="ToggleRetailMode">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Class="header-btn-icon" />
                            <span>@(IsRetailMode ? "Khudra Mode: ACTIVE" : "Retail Sale (Khudra)")</span>
                        </button>
                        <button class="header-btn-new" @onclick="StartNewTransaction">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="header-btn-icon" />
                            <span>New Transaction</span>
                        </button>
                    </div>
                </header>

                <MudStack Spacing="4">
                    <!-- Entity Informatics -->
                    <div class="terra-card">
                        <MudGrid Spacing="3" Class="align-center">
                            @if (!IsRetailMode)
                            {
                                <MudItem xs="12" md="8">
                                    <span class="section-headline">ENTITY / SHOP</span>
                                    <MudAutocomplete T="CustomerDto"
                                                     Value="SelectedCustomer"
                                                     ValueChanged="OnCustomerSelected"
                                                     SearchFunc="SearchCustomers"
                                                     ToStringFunc="@(c => c?.ShopName ?? "")"
                                                     Variant="Variant.Outlined"
                                                     Placeholder="Type entity or shop name..."
                                                     AdornmentIcon="@Icons.Material.Filled.Search"
                                                     AdornmentColor="Color.Secondary"
                                                     Class="input-field-h48" />
                                </MudItem>
                            }
                            else
                            {
                                <MudItem xs="12" md="3">
                                    <span class="section-headline">RETAIL SHOP NAME</span>
                                    <MudTextField @bind-Value="RetailShopName" Variant="Variant.Outlined" Placeholder="e.g. KHUDRA SALE" Class="input-field-h48" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <span class="section-headline">CUSTOMER NAME</span>
                                    <MudTextField @bind-Value="RetailCustomerName" Variant="Variant.Outlined" Placeholder="Customer Name" Class="input-field-h48" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <span class="section-headline">PHONE</span>
                                    <MudTextField @bind-Value="RetailPhone" Variant="Variant.Outlined" Placeholder="Mobile" Class="input-field-h48" />
                                </MudItem>
                            }
                            
                            <MudItem xs="12" md="4">
                                <span class="section-headline">FISCAL AUDIT DATE</span>
                                <div class="date-picker-card">
                                    <div class="calendar-icon-box">
                                        <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Class="calendar-icon" />
                                    </div>
                                    <div class="date-picker-details">
                                        <MudDatePicker @bind-Date="BillDate" 
                                                       Variant="Variant.Text" 
                                                       DisableUnderLine="true" 
                                                       Class="date-picker-input"
                                                       DateFormat="dd MMM yyyy" />
                                        <span class="date-day-label">@BillDate?.ToString("dddd")</span>
                                    </div>
                                </div>
                            </MudItem>
                            
                            @if (SelectedCustomer != null && !IsRetailMode)
                            {
                                <MudItem xs="12">
                                    <div class="selected-customer-card">
                                        <div class="customer-avatar-badge">
                                            @SelectedCustomer.ShopName.Substring(0, 1)
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.body2" Class="customer-shop-name">@SelectedCustomer.ShopName</MudText>
                                            <MudText Typo="Typo.caption" Class="customer-contact-info">Contact: @SelectedCustomer.CustomerName · @SelectedCustomer.PhoneNumber</MudText>
                                        </div>
                                    </div>
                                </MudItem>
                            }
                        </MudGrid>
                    </div>

                    <!-- Line Items -->
                    <div class="terra-card p-0">
                        <div class="trade-ledger-header">
                            <span class="section-headline mb-0-headline">TRADE LEDGER SNAPSHOT</span>
                            <MudSwitch @bind-Value="IncludeGST" Color="Color.Primary" Label="GST Audit" Class="gst-switch" />
                        </div>
                        
                        <div class="trade-ledger-body">
                            <table class="audit-table">
                                <thead>
                                    <tr>
                                        <th class="col-desc">Resource Description</th>
                                        <th class="col-weight">Weight</th>
                                        <th class="col-rate">Rate</th>
                                        <th class="col-total">Total</th>
                                        <th class="col-actions"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in BillRows)
                                    {
                                        <tr class="material-row">
                                            <td>
                                                <MudAutocomplete T="MaterialDto"
                                                                 Value="row.SelectedMaterial"
                                                                 ValueChanged="@(m => OnMaterialSelected(row, m))"
                                                                 SearchFunc="SearchMaterials"
                                                                 ToStringFunc="@(m => m == null ? "" : $"{m.Name} ({m.Shape})")"
                                                                 Variant="Variant.Text"
                                                                 Placeholder="Start typing resource..."
                                                                 Dense="true" />
                                            </td>
                                            <td>
                                                <MudNumericField T="decimal" 
                                                                Value="row.Quantity" 
                                                                ValueChanged="@(v => { row.Quantity = v; RecalcRow(row); })" 
                                                                Variant="Variant.Text" 
                                                                HideSpinButtons="true" 
                                                                Class="@(row.SelectedMaterial != null && row.Quantity > row.SelectedMaterial.StockMT ? "audit-quantity-error" : "audit-quantity-normal")" 
                                                                Error="@(row.SelectedMaterial != null && row.Quantity > row.SelectedMaterial.StockMT)"
                                                                ErrorText="Exceeds stock"
                                                                Margin="Margin.Dense" />
                                            </td>
                                            <td>
                                                <MudNumericField T="decimal" Value="row.UnitPrice" ValueChanged="@(v => { row.UnitPrice = v; RecalcRow(row); })" Variant="Variant.Text" HideSpinButtons="true" Class="audit-unit-price" Margin="Margin.Dense" />
                                            </td>
                                            <td class="text-right">
                                                <span class="audit-row-total">₹ @row.TotalPrice.ToString("N0")</span>
                                            </td>
                                            <td class="text-center">
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="() => RemoveRow(row)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                            <div class="insert-line-container" @onclick="AddRow">
                                <MudIcon Icon="@Icons.Material.Filled.Add" Class="insert-line-icon" />
                                <span>Insert Audit Line</span>
                            </div>
                        </div>
                    </div>

                    <!-- Supplemental Modals -->
                    <div class="terra-card">
                        <span class="section-headline">OPERATIONAL LOGISTICS</span>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" md="6">
                                <span class="section-headline sub-headline">BHADA AMOUNT</span>
                                <MudTextField @bind-Value="BhadaAmount" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.LocalShipping" AdornmentColor="Color.Primary" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <span class="section-headline sub-headline">GSTIN / REMARKS</span>
                                <MudTextField @bind-Value="GstinValue" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Notes" AdornmentColor="Color.Secondary" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="footer-actions">
                        <button class="footer-btn-commit" @onclick="GenerateInvoice" disabled="@IsSaving">
                            <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="footer-btn-icon" />
                            <span>Commit Final Audit</span>
                        </button>
                        <button class="footer-btn-archive" @onclick="SaveAsDraft" disabled="@IsSaving">
                            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Class="footer-btn-icon" />
                            <span>Archive Draft</span>
                        </button>
                        @if (!string.IsNullOrEmpty(GeneratedBillNumber))
                        {
                            <button class="footer-btn-download" @onclick="DownloadBill">
                                <MudIcon Icon="@Icons.Material.Filled.DownloadDone" Class="footer-btn-icon" />
                                <span>Download Documentation</span>
                            </button>
                        }
                    </div>
                </MudStack>
            </MudItem>

            <!-- Right Side: Sticky Audit Node -->
            <MudItem xs="12" lg="4">
                <div class="sticky-audit-node">
                    <div class="terra-card">
                        <span class="section-headline">AUDIT SUMMARY</span>
                        
                        <div class="audit-summary-item">
                            <span class="audit-summary-label">Aggregate Base</span>
                            <span class="audit-summary-value">₹ @SubTotal.ToString("N0")</span>
                        </div>

                        <div class="audit-summary-item">
                            <span class="audit-summary-label">Logistics (Bhada)</span>
                            <span class="audit-summary-value">₹ @BhadaAmount.ToString("N0")</span>
                        </div>

                        @if (LabourAmount > 0)
                        {
                            <div class="audit-summary-item">
                                <span class="audit-summary-label">Operational Labour</span>
                                <span class="audit-summary-value">₹ @LabourAmount.ToString("N0")</span>
                            </div>
                        }

                        <div class="divider-dashed"></div>

                        <span class="section-headline mb-4-px">FINAL VALUATION</span>
                        <div class="final-valuation-container">
                            <div class="valuation-number-box">
                                <span class="currency-symbol">₹</span>
                                <span class="valuation-amount">@Math.Round(GrandTotal).ToString("N0")</span>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.BarChart" Class="valuation-chart-icon" />
                        </div>
                    </div>

                    <!-- Real-time Payment Realization -->
                    <div class="terra-card">
                        <span class="section-headline">COLLECTION BREAKDOWN</span>
                        
                        <div class="payment-cards-list">
                            <div class="payment-card">
                                <div class="payment-card-icon-box">
                                    <MudIcon Icon="@Icons.Material.Filled.Payments" Style="color: var(--mud-palette-primary); font-size: 1.15rem;" />
                                </div>
                                <div class="flex-grow-1">
                                    <span class="payment-card-label">Cash Payment (नकद)</span>
                                    <MudNumericField T="decimal" 
                                                     Value="CashAmount" 
                                                     ValueChanged="@(v => { CashAmount = v; StateHasChanged(); })"
                                                     Variant="Variant.Text" 
                                                     Underline="false" 
                                                     HideSpinButtons="true" 
                                                     Class="payment-input" />
                                </div>
                            </div>
                            <div class="payment-card">
                                <div class="payment-card-icon-box">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="color: var(--mud-palette-primary); font-size: 1.15rem;" />
                                </div>
                                <div class="flex-grow-1">
                                    <span class="payment-card-label">A/C Payment (बैंक)</span>
                                    <MudNumericField T="decimal" 
                                                     Value="AccountAmount" 
                                                     ValueChanged="@(v => { AccountAmount = v; StateHasChanged(); })"
                                                     Variant="Variant.Text" 
                                                     Underline="false" 
                                                     HideSpinButtons="true" 
                                                     Class="payment-input" />
                                </div>
                            </div>
                        </div>
                        
                        <div class="payment-actions">
                            <MudButton Size="Size.Small" OnClick='() => { CashAmount = GrandTotal; AccountAmount = 0; }' Variant="Variant.Text" Class="payment-helper-btn">Full Cash</MudButton>
                            <MudButton Size="Size.Small" OnClick='() => { CashAmount = 0; AccountAmount = GrandTotal; }' Variant="Variant.Text" Class="payment-helper-btn">Full A/C</MudButton>
                            <MudSpacer />
                            <div class="dues-badge @(BalanceDue > 0 ? "has-dues" : "")">
                                TOTAL DUES: ₹ @BalanceDue.ToString("N0")
                            </div>
                        </div>

                        @if (BalanceDue > 0)
                        {
                            <div class="digital-settlement-card">
                                <MudText Typo="Typo.caption" Class="upi-badge-title">DIGITAL SETTLEMENT (UPI)</MudText>
                                <img src="@($"https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=upi://pay?pa=risham123sharma@ybl%26pn=Vikash%20Iron%26am={BalanceDue}%26cu=INR")" alt="UPI QR" class="upi-qr-code" />
                                <MudText Typo="Typo.body2" Class="upi-address">risham123sharma@ybl</MudText>
                                <MudText Typo="Typo.caption" Class="upi-verification">Verified: Rishabh Kumar Sharma</MudText>
                            </div>
                        }

                        <button class="btn-inspect-invoice" @onclick="TogglePreview">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="inspect-btn-icon" />
                            <span>@(ShowPreview ? "COLLAPSE AUDIT" : "INSPECT INVOICE")</span>
                        </button>

                        @if (ShowPreview)
                        {
                            <div class="invoice-preview-card mt-4">
                                <div class="invoice-preview-container">
                                    <!-- Fiscal Header -->
                                    <div class="invoice-preview-header">
                                        <div>
                                            <div class="preview-tax-label">TAX INVOICE</div>
                                            <div class="preview-company-name">VIKASH IRON AND STEEL</div>
                                            <div class="preview-company-address">EKMA PARSA ROAD · SESSION 2026-27</div>
                                        </div>
                                        <div class="text-right">
                                            <div class="preview-bill-number">@(GeneratedBillNumber ?? "DRAFT")</div>
                                            <div class="preview-bill-date">@BillDate?.ToString("dd MMM yyyy")</div>
                                            @if (BalanceDue > 0)
                                            {
                                                <div class="preview-dues">DUES: ₹@BalanceDue.ToString("N0")</div>
                                            }
                                            else
                                            {
                                                <div class="preview-paid">PAID IN FULL</div>
                                            }
                                        </div>
                                    </div>

                                    <!-- Entity Mapping -->
                                    <div class="invoice-preview-entities">
                                        <div>
                                            <div class="preview-section-title">BILL TO</div>
                                            <div class="preview-entity-name">@(IsRetailMode ? RetailShopName : (SelectedCustomer?.ShopName ?? "NO ENTITY SELECTED"))</div>
                                            <div class="preview-entity-details">@(IsRetailMode ? $"{RetailCustomerName} · {RetailPhone}" : SelectedCustomer?.PhoneNumber)</div>
                                        </div>
                                        @if (IncludeGST && !string.IsNullOrEmpty(GstinValue))
                                        {
                                            <div class="text-right">
                                                <div class="preview-section-title">GSTIN</div>
                                                <div class="preview-entity-name">@GstinValue</div>
                                            </div>
                                        }
                                    </div>

                                    <!-- Audit Ledger Table -->
                                    <table class="preview-table">
                                        <thead>
                                            <tr class="preview-header-row">
                                                <th class="text-left preview-th">Item</th>
                                                <th class="text-right preview-th">Qty</th>
                                                <th class="text-right preview-th">Amt</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in BillRows.Where(x => x.SelectedMaterial != null).Take(8))
                                            {
                                                <tr class="preview-item-row">
                                                    <td class="preview-td">@r.SelectedMaterial?.Name</td>
                                                    <td class="preview-td text-right">@r.Quantity.ToString("N0")</td>
                                                    <td class="preview-td text-right preview-td-total">₹ @r.TotalPrice.ToString("N0")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>

                                    <!-- Fiscal Finalization -->
                                    <div class="preview-totals">
                                        @if (IncludeGST)
                                        {
                                            <div class="preview-total-row">GST (9% + 9%): ₹ @((CGSTAmount + SGSTAmount).ToString("N0"))</div>
                                        }
                                        @if (BhadaAmount > 0)
                                        {
                                            <div class="preview-total-row">Logistics: ₹ @BhadaAmount.ToString("N0")</div>
                                        }
                                        <div class="preview-grand-total">₹ @GrandTotal.ToString("N0")</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Warehouse Pulse Indicators -->
                    <div class="terra-card">
                        <div class="warehouse-pulse-header">
                            <span class="section-headline mb-0-headline">WAREHOUSE PULSE</span>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--mud-palette-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="warehouse-pulse-icon"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        </div>
                        @if (!BillRows.Any(r => r.SelectedMaterial != null))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="warehouse-pulse-empty">Resource telemetry.</MudText>
                        }
                        <MudStack Spacing="3">
                            @foreach (var row in BillRows.Where(r => r.SelectedMaterial != null))
                            {
                                <div>
                                    <div class="warehouse-pulse-row">
                                        <MudText Typo="Typo.caption" Class="warehouse-material-name">@row.SelectedMaterial!.Name</MudText>
                                        <MudText Typo="Typo.caption" Class="warehouse-material-stock">@row.SelectedMaterial.StockMT KG</MudText>
                                    </div>
                                    <MudProgressLinear Color="Color.Primary" Value="@((double)row.SelectedMaterial.StockMT)" Max="20000" Rounded="true" Size="Size.Small" Class="warehouse-progress-bar" />
                                </div>
                            }
                        </MudStack>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
        
        <!-- Bottom Section: Pending Drafts Grid -->
        <div class="main-canvas mt-8 pb-10">
            <div class="terra-card">
                <div class="pending-drafts-header">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="pending-drafts-title">PENDING DRAFTS</MudText>
                        <MudText Typo="Typo.caption" Class="pending-drafts-subtitle">Unfinished fiscal audits in your queue.</MudText>
                    </div>
                    <MudButton StartIcon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Variant="Variant.Text" OnClick="LoadDrafts" Size="Size.Small" Class="pending-drafts-sync-btn">Synchronize Queue</MudButton>
                </div>

                <MudTable Items="@DraftBills" Hover="true" Elevation="0" Dense="true" Class="pending-drafts-table">
                    <HeaderContent>
                        <MudTh Class="draft-th col-id">Draft ID</MudTh>
                        <MudTh Class="draft-th col-entity">Shop / Entity</MudTh>
                        <MudTh Class="draft-th col-date">Date</MudTh>
                        <MudTh Class="draft-th col-total text-right">Total (₹)</MudTh>
                        <MudTh Class="draft-th col-actions text-right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="draft-td draft-id">@context.BillNumber</MudTd>
                        <MudTd Class="draft-td draft-entity">@(string.IsNullOrEmpty(context.ShopName) ? "Quick/Retail Draft" : context.ShopName.ToUpper())</MudTd>
                        <MudTd Class="draft-td draft-date">@context.BillDate.ToString("dd MMM yyyy")</MudTd>
                        <MudTd Class="draft-td draft-total text-right">₹ @context.GrandTotal.ToString("N0")</MudTd>
                        <MudTd Class="draft-td draft-actions text-right">
                            <div class="draft-actions-wrapper">
                                <MudIconButton Icon="@Icons.Material.Filled.Autorenew" Size="Size.Small" Color="Color.Primary" OnClick="() => ResumeDraft(context)" Class="draft-action-btn primary" />
                                <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteDraft(context.Id)" Class="draft-action-btn error" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-12 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.History" Class="draft-empty-icon" />
                            <MudText Typo="Typo.body2" Class="draft-empty-text">The draft queue is currently empty.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </div>
        </div>
    </div>
</div>

@code {
    // ── Data ────────────────────────────────────────────────
    private List<CustomerDto> CustomerList = new();
    private List<MaterialDto> MaterialList = new();

    // ── Customer Binding ────────────────────────────────────
    private CustomerDto? SelectedCustomer;
    private bool IsRetailMode = false;
    private string RetailShopName = "";
    private string RetailCustomerName = "";
    private string RetailPhone = "";
    private string GstinValue = "";
    private DateTime? BillDate = DateTime.Today;
    private decimal CashAmount = 0;
    private decimal AccountAmount = 0;

    // ── Bill Options ─────────────────────────────────────────
    private bool IncludeGST = false;
    private decimal BhadaAmount = 0;
    private decimal LabourRate = 25; // ₹ per quintal (100 kg)

    // ── Material Rows ───────────────────────────────────────
    private List<BillRow> BillRows = new() { new BillRow() };

    // ── Computed Totals ─────────────────────────────────────
    private decimal TotalQuantityKg   => BillRows.Sum(r => r.Quantity);
    private decimal LabourAmount      => Math.Round((TotalQuantityKg / 100m) * LabourRate, 2);
    private decimal SubTotal          => BillRows.Sum(r => r.TotalPrice);
    private decimal CGSTAmount        => IncludeGST ? Math.Round(SubTotal * 0.09m, 2) : 0;
    private decimal SGSTAmount        => IncludeGST ? Math.Round(SubTotal * 0.09m, 2) : 0;
    private decimal PreRoundTotal     => SubTotal + CGSTAmount + SGSTAmount + BhadaAmount + LabourAmount;
    private decimal RoundingAdjustment => Math.Round(PreRoundTotal) - PreRoundTotal;
    private decimal GrandTotal        => PreRoundTotal + RoundingAdjustment;
    private decimal BalanceDue        => GrandTotal - (CashAmount + AccountAmount);

    // ── Preview Toggle ───────────────────────────────────────
    private bool ShowPreview = false;
    private void TogglePreview() => ShowPreview = !ShowPreview;

    private List<BillDto> DraftBills = new();
    private Guid? ActiveBillId;

    // ── Lifecycle ───────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
        await LoadDrafts();
    }

    private async Task LoadInitialData()
    {
        try { CustomerList = await CustomerService.GetCustomersAsync(); } catch { }
        try { MaterialList = await InventoryService.GetMaterialsAsync(); } catch { }
    }

    private async Task LoadDrafts()
    {
        try 
        { 
            var all = await BillService.GetBillsAsync();
            DraftBills = all.Where(b => b.Status == "Draft").Take(10).ToList();
        } 
        catch { }
    }

    // ── Stock UI Helpers ─────────────────────────────────────
    private bool IsLowStock(BillRow row) => row.SelectedMaterial!.StockMT < 500;
    private string GetBarColor(BillRow row) => IsLowStock(row) ? "var(--mud-palette-error)" : "var(--mud-palette-primary)";
    private string GetStockIconStyle(BillRow row)
    {
        var bg = IsLowStock(row) ? "rgba(255,180,171,0.1)" : "rgba(110,229,145,0.1)";
        return $"height:40px;width:40px;border-radius:4px;background:{bg};display:flex;align-items:center;justify-content:center;flex-shrink:0;";
    }
    private string GetStockIconColor(BillRow row)
    {
        var c = GetBarColor(row);
        return $"color:{c};font-size:20px;";
    }
    private string GetStockBarStyle(BillRow row)
    {
        var pct = Math.Min(100, (int)(row.SelectedMaterial!.StockMT / 20000 * 100));
        return $"background:{GetBarColor(row)};height:4px;border-radius:4px;width:{pct}%;";
    }
    private string GetStockLabel(BillRow row)
    {
        var prefix = IsLowStock(row) ? "⚠ Low Stock: " : "";
        return $"{prefix}{row.SelectedMaterial!.StockMT} KG in stock";
    }

    // ── Customer Search & Auto-fill ─────────────────────────
    private Task<IEnumerable<CustomerDto>> SearchCustomers(string search, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(search))
            return Task.FromResult(CustomerList.Take(20).AsEnumerable());

        var results = CustomerList
            .Where(c => c.ShopName.Contains(search, StringComparison.OrdinalIgnoreCase)
                     || c.PhoneNumber.Contains(search, StringComparison.OrdinalIgnoreCase)
                     || c.CustomerName.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(10);

        return Task.FromResult(results.AsEnumerable());
    }

    private void OnCustomerSelected(CustomerDto? customer)
    {
        SelectedCustomer = customer;
        BhadaAmount = customer?.Bhada ?? 0;   // auto-fill from customer's default bhada rate
        StateHasChanged();
    }

    private void ToggleRetailMode()
    {
        IsRetailMode = !IsRetailMode;
        if (IsRetailMode)
        {
            SelectedCustomer = null; 
            if (string.IsNullOrEmpty(RetailShopName)) RetailShopName = "KHUDRA SALE";
            if (string.IsNullOrEmpty(RetailCustomerName)) RetailCustomerName = "CASH CUSTOMER";
            BhadaAmount = 0;
        }
    }

    // ── Material Search ─────────────────────────────────────
    private Task<IEnumerable<MaterialDto>> SearchMaterials(string search, CancellationToken _)
    {
        if (string.IsNullOrWhiteSpace(search))
            return Task.FromResult(MaterialList.Take(20).AsEnumerable());

        var results = MaterialList
            .Where(m => m.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                     || m.Shape.Contains(search, StringComparison.OrdinalIgnoreCase)
                     || m.CategoryName.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Take(10);

        return Task.FromResult(results.AsEnumerable());
    }

    private void OnMaterialSelected(BillRow row, MaterialDto? material)
    {
        row.SelectedMaterial = material;
        if (material != null)
        {
            row.UnitPrice = material.GlobalRate;
            row.TaxPercentage = 18;
        }
        RecalcRow(row);
    }

    // ── Row Management ──────────────────────────────────────
    private void AddRow() => BillRows.Add(new BillRow());
    private void RemoveRow(BillRow row) { if (BillRows.Count > 1) BillRows.Remove(row); }

    private void RecalcRow(BillRow row)
    {
        row.TotalPrice = Math.Round(row.Quantity * row.UnitPrice, 2);
        StateHasChanged();
    }

    // ── Actions ─────────────────────────────────────────────
    private string? GeneratedBillNumber;
    private bool IsSaving = false;

    private async Task GenerateInvoice() => await SubmitBill("Pending");
    private async Task SaveAsDraft()     => await SubmitBill("Draft");

    private async Task SubmitBill(string status)
    {
        if (!IsRetailMode && SelectedCustomer == null) { Snackbar.Add("Please select a customer.", Severity.Warning); return; }
        if (IsRetailMode && string.IsNullOrEmpty(RetailShopName)) { Snackbar.Add("Please enter a retail shop name.", Severity.Warning); return; }
        if (!BillRows.Any(r => r.SelectedMaterial != null && r.Quantity > 0)) { Snackbar.Add("Add at least one material with quantity.", Severity.Warning); return; }

        // Stock Validation (Only for non-draft finalized invoices)
        if (status != "Draft")
        {
            foreach (var row in BillRows.Where(r => r.SelectedMaterial != null))
            {
                if (row.Quantity > row.SelectedMaterial!.StockMT)
                {
                    Snackbar.Add($"INSUFFICIENT STOCK: '{row.SelectedMaterial.Name}' only has {row.SelectedMaterial.StockMT} KG available.", Severity.Error);
                    return;
                }
            }
        }

        IsSaving = true;
        try
        {
            Guid finalCustomerId = Guid.Empty;
            if (IsRetailMode)
            {
                var khudra = CustomerList.FirstOrDefault(c => c.ShopName.ToUpper().Contains("KHUDRA"));
                if (khudra == null)
                {
                    // Fetch roles to get a valid one
                    var roles = await UserService.GetRolesAsync();
                    var targetRole = roles.FirstOrDefault(r => r.Name.Contains("Customer", StringComparison.OrdinalIgnoreCase)) ?? roles.FirstOrDefault();
                    
                    if (targetRole == null)
                    {
                        Snackbar.Add("Infrastructure Error: No Roles defined in system. Please create a role first.", Severity.Error);
                        return;
                    }

                    var newKhudra = new CustomerDto
                    {
                        FirstName = "RETAIL",
                        LastName = "SALE",
                        Email = $"khudra.{Guid.NewGuid().ToString().Substring(0, 4)}@vias.com",
                        RoleId = targetRole.Id,
                        ShopName = "KHUDRA SALE",
                        CustomerName = "Retail/Cash",
                        PhoneNumber = "0000000000",
                        IsActive = true
                    };
                    await CustomerService.CreateCustomerAsync(newKhudra);
                    CustomerList = await CustomerService.GetCustomersAsync();
                    khudra = CustomerList.FirstOrDefault(c => c.ShopName.ToUpper().Contains("KHUDRA"));
                }
                finalCustomerId = khudra?.Id ?? Guid.Empty;
            }
            else
            {
                finalCustomerId = SelectedCustomer!.Id;
            }

            if (finalCustomerId == Guid.Empty)
            {
                Snackbar.Add("Could not resolve Customer Identity. Please contact support.", Severity.Error);
                return;
            }

            var bill = new BillDto
            {
                Id           = ActiveBillId ?? Guid.Empty,
                CustomerId   = finalCustomerId,
                BillDate     = BillDate ?? DateTime.Today,
                SubTotal     = SubTotal,
                CGSTAmount   = CGSTAmount,
                SGSTAmount   = SGSTAmount,
                IGSTAmount   = 0,
                BhadaAmount  = BhadaAmount,
                LabourAmount = LabourAmount,
                RoundingAdjustment = RoundingAdjustment,
                GrandTotal   = GrandTotal,
                CashPaid     = CashAmount,
                AmountPaid   = AccountAmount,
                BalanceDue   = GrandTotal - (CashAmount + AccountAmount),
                TotalWeightKg = TotalQuantityKg,
                Notes        = IsRetailMode ? $"[RETAIL: {RetailShopName} / {RetailCustomerName}] {GstinValue}" : GstinValue,
                Status       = status,
                Items        = BillRows
                    .Where(r => r.SelectedMaterial != null && r.Quantity > 0)
                    .Select(r => new BillItemDto
                    {
                        MaterialId    = r.SelectedMaterial!.Id,
                        MaterialName  = r.SelectedMaterial.Name,
                        Quantity      = r.Quantity,
                        UnitPrice     = r.UnitPrice,
                        TaxPercentage = r.TaxPercentage,
                        TotalPrice    = r.TotalPrice
                    }).ToList()
            };

            if (ActiveBillId != null)
            {
                await BillService.UpdateBillAsync(bill);
                Snackbar.Add($"Updated Draft — {GeneratedBillNumber}", Severity.Success);
            }
            else
            {
                var result = await BillService.CreateBillAsync(bill);
                GeneratedBillNumber = result.BillNumber;
                ActiveBillId = result.InsertedId;
                Snackbar.Add(status == "Draft" ? $"Draft saved — {GeneratedBillNumber}" : $"Invoice {GeneratedBillNumber} generated!", Severity.Success);
            }

            await LoadDrafts(); // Refresh bottom grid
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error, config => config.SnackbarVariant = Variant.Filled);
        }
        finally { IsSaving = false; }
    }

    private async Task ResumeDraft(BillDto draft)
    {
        try
        {
            var fullBill = await BillService.GetBillByIdAsync(draft.Id);
            ActiveBillId = fullBill.Id;
            SelectedCustomer = CustomerList.FirstOrDefault(c => c.Id == fullBill.CustomerId);
            BillDate = fullBill.BillDate;
            GstinValue = fullBill.Notes;
            GeneratedBillNumber = fullBill.BillNumber;
            CashAmount = fullBill.CashPaid;
            AccountAmount = fullBill.AmountPaid;
            BhadaAmount = fullBill.BhadaAmount;

            BillRows.Clear();
            foreach (var item in fullBill.Items)
            {
                var mat = MaterialList.FirstOrDefault(m => m.Id == item.MaterialId);
                BillRows.Add(new BillRow 
                { 
                    SelectedMaterial = mat,
                    Quantity = item.Quantity,
                    UnitPrice = item.UnitPrice,
                    TaxPercentage = item.TaxPercentage,
                    TotalPrice = item.TotalPrice
                });
            }
            if (!BillRows.Any()) BillRows.Add(new BillRow());
            
            Snackbar.Add($"Resumed Draft {fullBill.BillNumber}", Severity.Info);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not resume draft: {ex.Message}", Severity.Error);
        }
    }

