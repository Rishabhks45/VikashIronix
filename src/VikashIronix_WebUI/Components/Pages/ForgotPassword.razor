@page "/forgot-password"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@layout LoginLayout
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject VikashIronix_WebUI.Services.AuthServices.Interfaces.IAuthService AuthService

<PageTitle>Recover Access - Vikashironix Executive Suite</PageTitle>

<div class="login-container">
    <!-- Left panel (feature presentation) -->
    <div class="left-panel">
        <!-- Top brand -->
        <div class="left-brand">
            <div class="logo-box">VI</div>
            <div>
                <span class="left-brand-title">Vikashironix</span>
                <span class="left-brand-subtitle">EXECUTIVE SUITE</span>
            </div>
        </div>

        <!-- Center content -->
        <div class="left-center">
            <h1 class="left-heading">Manage your iron business smarter.</h1>
            <p class="left-desc">
                Complete suite for billing, inventory, payroll and customer management — all in one place.
            </p>

            <div class="features-list">
                <div class="feature-card">
                    <div class="feature-icon icon-analytics">
                        <!-- Custom SVG Chart Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"></line>
                            <line x1="12" y1="20" x2="12" y2="4"></line>
                            <line x1="6" y1="20" x2="6" y2="14"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="feature-title">Real-time Analytics</div>
                        <div class="feature-desc">Track revenue, stock & customers live</div>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon icon-inventory">
                        <!-- Custom SVG Box Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                            <line x1="12" y1="22.08" x2="12" y2="12"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="feature-title">Smart Inventory</div>
                        <div class="feature-desc">Full material catalog with stock alerts</div>
                    </div>
                </div>

                <div class="feature-card">
                    <div class="feature-icon icon-ledger">
                        <!-- Custom SVG Ledger/Invoice Icon -->
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="16" y1="6" x2="8" y2="6"></line>
                            <line x1="16" y1="10" x2="8" y2="10"></line>
                            <line x1="16" y1="14" x2="8" y2="14"></line>
                            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        </svg>
                    </div>
                    <div>
                        <div class="feature-title">Billing & Ledger</div>
                        <div class="feature-desc">Invoices, udhaar tracking & daily audits</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom brand info -->
        <div class="left-footer">
            v4.0.0 PRO - Enterprise
        </div>
    </div>

    <!-- Right panel (Forgot Password form) -->
    <div class="right-panel">
        <div style="flex-grow: 1; display: flex; align-items: center; width: 100%;">
            <div class="login-form-wrapper">
                <!-- Welcome headers -->
                <div class="welcome-header">
                    <h2 class="welcome-title">Recover Access</h2>
                    <p class="welcome-subtitle">Enter your registered operational email address to recover access.</p>
                </div>

                @if (!string.IsNullOrEmpty(FeedbackMsg))
                {
                    var severity = IsSuccess ? Severity.Success : Severity.Error;
                    var bg = IsSuccess ? "rgba(16, 185, 129, 0.08)" : "rgba(239, 68, 68, 0.08)";
                    var fg = IsSuccess ? "#059669" : "#dc2626";
                    var border = IsSuccess ? "rgba(16, 185, 129, 0.15)" : "rgba(239, 68, 68, 0.15)";
                    <MudAlert Severity="@severity" Dense="true" Style=$"background: {bg}; color: {fg}; border: 1px solid {border}; border-radius: 12px; font-weight: 500; font-size: 0.85rem; padding: 10px 14px; margin-bottom: 20px;">
                        @FeedbackMsg
                    </MudAlert>
                }

                <MudStack Spacing="4">
                    <!-- Email / Username input -->
                    <div>
                        <label class="custom-label">Registered Email</label>
                        <MudTextField @bind-Value="Email"
                                      Variant="Variant.Outlined"
                                      InputType="InputType.Email"
                                      Placeholder="j.smith@vikashiron.com"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Email"
                                      Margin="Margin.None"
                                      FullWidth="true"
                                      Class="glass-input" />
                    </div>

                    <!-- Submit Button -->
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               OnClick="HandleRecovery"
                               Class="login-button"
                               Disabled="IsLoading">
                        @if (IsLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-3" Style="color: #ffffff;" />
                            <span>PROCESSING...</span>
                        }
                        else
                        {
                            <span>SEND RECOVERY LINK</span>
                        }
                    </MudButton>

                    <MudButton Variant="Variant.Text" FullWidth="true" OnClick="@(() => Nav.NavigateTo("/login"))" Style="color: #6366f1; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; margin-top: 8px;">
                        Return to Login
                    </MudButton>

                    <!-- System Status -->
                    <div style="text-align: center;">
                        <div class="status-container">
                            <div class="status-dot-pulse"></div>
                            <span class="status-lbl">All systems operational</span>
                        </div>
                    </div>
                </MudStack>
            </div>
        </div>

        <!-- Footer links -->
        <div class="right-footer">
            <a href="#" class="right-footer-link">Privacy</a>
            <a href="#" class="right-footer-link">Terms</a>
            <a href="#" class="right-footer-link">Support</a>
        </div>
    </div>
</div>

@code {
    string Email = "";
    bool IsLoading = false;
    string FeedbackMsg = "";
    bool IsSuccess = false;

    async Task HandleRecovery()
    {
        FeedbackMsg = "";
        IsSuccess = false;
        
        if (string.IsNullOrWhiteSpace(Email))
        {
            FeedbackMsg = "Provide a valid email address.";
            return;
        }

        IsLoading = true;
        bool result = await AuthService.ForgotPasswordAsync(Email);
        
        IsLoading = false;
        IsSuccess = true;
        FeedbackMsg = "If a matching operational account was found, a recovery link has been transmitted. Check your secure inbox.";
    }
}
