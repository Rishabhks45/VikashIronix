@page "/"
@rendermode InteractiveServer

<PageTitle>Executive Dashboard - The Iron Ledger</PageTitle>

@* <!-- Dashboard Header -->
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Justify="Justify.SpaceBetween" Style="padding: 0 0 12px 0; border-bottom: 1px solid var(--mud-palette-divider);">
    <div>
        <MudText Typo="Typo.h6" Style="font-family: var(--mud-typography-h6-font-family); font-weight: 800; letter-spacing: -0.5px; margin: 0;">Executive Dashboard</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-top: 2px;">Intelligence & Operations</MudText>
    </div>
    <MudStack Row="true" Spacing="1">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Default" Size="Size.Small" />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" Size="Size.Small" />
    </MudStack>
</MudStack> *@

<!-- KPI Row with Enhanced Styling -->
<MudGrid Spacing="2" Class="mb-4">
    <!-- Today's Revenue KPI -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px; background: linear-gradient(135deg, rgba(34, 197, 94, 0.08) 0%, rgba(34, 197, 94, 0.02) 100%); position: relative; overflow: hidden;" Class="pa-3">
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--mud-palette-success), transparent);"></div>
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Style="font-size: 0.65rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">Revenue</MudText>
                    <span style="font-size: 1.1rem;">📈</span>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Success" Style="font-family: 'Courier New', monospace; font-weight: 900; letter-spacing: -0.5px; line-height: 1.1;">₹12.84L</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" Size="Size.Small" Style="font-size: 0.8rem;" />
                    <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 700; font-size: 0.65rem;">+8.3%</MudText>
                </MudStack>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Total Stock KPI -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px; background: linear-gradient(135deg, rgba(33, 150, 243, 0.08) 0%, rgba(33, 150, 243, 0.02) 100%); position: relative; overflow: hidden;" Class="pa-3">
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--mud-palette-info), transparent);"></div>
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Style="font-size: 0.65rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">Stock</MudText>
                    <span style="font-size: 1.1rem;">📦</span>
                </MudStack>
                <MudText Typo="Typo.body1" Style="font-family: 'Courier New', monospace; font-weight: 900; letter-spacing: -0.5px; line-height: 1.1;">4,280 MT</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; font-size: 0.65rem;">3 nodes</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Outstanding Udhaar KPI -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px; background: linear-gradient(135deg, rgba(244, 67, 54, 0.08) 0%, rgba(244, 67, 54, 0.02) 100%); position: relative; overflow: hidden;" Class="pa-3">
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--mud-palette-error), transparent);"></div>
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Style="font-size: 0.65rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">Udhaar</MudText>
                    <span style="font-size: 1.1rem;">⚠️</span>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Error" Style="font-family: 'Courier New', monospace; font-weight: 900; letter-spacing: -0.5px; line-height: 1.1;">₹84.20L</MudText>
                <MudText Typo="Typo.caption" Color="Color.Error" Style="font-weight: 700; font-size: 0.65rem;">15 days</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Net Assets KPI -->
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px; background: linear-gradient(135deg, rgba(33, 150, 243, 0.08) 0%, rgba(33, 150, 243, 0.02) 100%); position: relative; overflow: hidden;" Class="pa-3">
            <div style="position: absolute; top: 0; left: 0; right: 0; height: 2px; background: linear-gradient(90deg, var(--mud-palette-primary), transparent);"></div>
            <MudStack Spacing="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Style="font-size: 0.65rem; font-weight: 700; color: var(--mud-palette-text-secondary); letter-spacing: 0.05em; text-transform: uppercase;">Assets</MudText>
                    <span style="font-size: 1.1rem;">💰</span>
                </MudStack>
                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-family: 'Courier New', monospace; font-weight: 900; letter-spacing: -0.5px; line-height: 1.1;">₹2.45 Cr</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; font-size: 0.65rem;">Collateral</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<!-- Main Content Grid -->
<MudGrid Spacing="2" Class="mt-4">
    <!-- Left Column: Top Customers -->
    <MudItem xs="12" md="5">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Style="font-family: var(--mud-typography-h6-font-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                    <span style="font-size: 1rem; margin-right: 4px;">👥</span>Top Customers
                </MudText>
                <MudLink Href="#" Underline="Underline.None" Style="font-size: 0.75rem; font-weight: 700; color: var(--mud-palette-primary);">View</MudLink>
            </MudStack>
            <MudStack Spacing="0">
                @foreach (var c in TopCustomers)
                {
                    <div style="display: flex; align-items: center; gap: 8px; padding: 8px; border-radius: 6px; border-bottom: 1px solid var(--mud-palette-divider); transition: all 0.2s ease;" class="customer-item">
                        <div style="width: 24px; height: 24px; background: var(--mud-palette-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 0.75rem; flex-shrink: 0;">
                            @(TopCustomers.IndexOf(c) + 1)
                        </div>
                        <div style="flex-grow: 1; min-width: 0;">
                            <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@c.Name</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.6rem;">@c.Tier</MudText>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Success" Style="font-weight: 800; font-family: 'Courier New', monospace; white-space: nowrap; font-size: 0.75rem;">@c.Volume</MudText>
                    </div>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <!-- Right Column: Operational Velocity & Liquidity Watchlist -->
    <MudItem xs="12" md="7">
        <MudStack Spacing="2">
            <!-- Operational Velocity -->
            <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Style="font-family: var(--mud-typography-h6-font-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                        <span style="font-size: 1rem; margin-right: 4px;">⚡</span>Velocity
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Icon="@Icons.Material.Filled.FiberManualRecord" Style="font-weight: 700; background: rgba(34, 197, 94, 0.15); font-size: 0.65rem;">Live</MudChip>
                </MudStack>
                <MudStack Spacing="0">
                    @foreach (var item in FastMoving)
                    {
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 8px; border-radius: 6px; border-bottom: 1px solid var(--mud-palette-divider); gap: 8px; transition: all 0.2s ease;" class="operational-item">
                            <div style="flex-grow: 1; min-width: 0;">
                                <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@item.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.6rem;">@item.Alert</MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="@(item.Status == "Critical" ? Color.Error : item.Status == "Active" ? Color.Success : Color.Default)" Variant="Variant.Text" Style="font-weight: 700; text-transform: uppercase; font-size: 0.65rem;">@item.Status</MudChip>
                        </div>
                    }
                </MudStack>
            </MudPaper>

            <!-- Liquidity Watchlist -->
            <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;" Class="pa-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.caption" Style="font-family: var(--mud-typography-h6-font-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                        <span style="font-size: 1rem; margin-right: 4px;">⚠️</span>Watchlist
                    </MudText>
                    <MudLink Href="#" Underline="Underline.None" Style="font-size: 0.75rem; font-weight: 700; color: var(--mud-palette-primary);">View</MudLink>
                </MudStack>
                <MudStack Spacing="1">
                    @foreach (var d in Defaulters)
                    {
                        <div style="display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 8px; border-radius: 6px; background: rgba(0, 0, 0, 0.2); border-left: 2px solid var(--mud-palette-error); transition: all 0.2s ease;" class="watchlist-item">
                            <div style="min-width: 0;">
                                <MudText Typo="Typo.caption" Style="font-weight: 700; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@d.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Error" Style="font-weight: 700; font-size: 0.6rem;">@d.Days Days</MudText>
                            </div>
                            <div style="text-align: right;">
                                <MudText Typo="Typo.caption" Color="Color.Error" Style="font-weight: 800; font-family: 'Courier New', monospace; font-size: 0.75rem; display: block;">@d.Amount</MudText>
                                <span style="font-size: 0.9rem; color: var(--mud-palette-text-secondary);">→</span>
                            </div>
                        </div>
                    }
                </MudStack>
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>

<!-- Recent Strategic Trades Section -->
<MudGrid Spacing="2" Class="mt-4">
    <MudItem xs="12">
        <MudPaper Elevation="0" Style="border: 1px solid var(--mud-palette-divider); border-radius: 8px;" Class="pa-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption" Style="font-family: var(--mud-typography-h6-font-family); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
                    <span style="font-size: 1rem; margin-right: 4px;">📊</span>Recent Trades
                </MudText>
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Style="font-weight: 700; font-size: 0.7rem;">EXPAND</MudButton>
            </MudStack>
            <div style="overflow-x: auto;">
                <MudTable Items="@Trades" Hover="true" Elevation="0" Style="background: transparent;" Dense="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">ID</MudTh>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Customer</MudTh>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Material</MudTh>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">QTY</MudTh>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Value</MudTh>
                        <MudTh Style="font-size: 0.6rem; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary); text-transform: uppercase;">Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Style="font-family: 'Courier New', monospace; font-weight: 700; color: var(--mud-palette-primary); font-size: 0.75rem;">@context.Id</MudTd>
                        <MudTd Style="font-weight: 700; font-size: 0.75rem;">@context.Customer</MudTd>
                        <MudTd Style="color: var(--mud-palette-text-secondary); font-size: 0.75rem;">@context.Material</MudTd>
                        <MudTd Style="font-weight: 600; font-size: 0.75rem;">@context.Qty</MudTd>
                        <MudTd Style="font-family: 'Courier New', monospace; font-weight: 800; color: var(--mud-palette-success); font-size: 0.75rem;">@context.Value</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@(context.Status == "Delivered" ? Color.Success : context.Status == "Overdue" ? Color.Error : context.Status == "In Transit" ? Color.Info : Color.Warning)" Variant="Variant.Text" Style="font-weight: 700; font-size: 0.6rem;">@context.Status</MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    record TopCustomer(string Name, string Tier, string Volume);
    record StockAlert(string Name, string Alert, string AlertColor, string Status, string ChipStyle);
    record DefaulterEntry(string Name, int Days, string Amount);
    record Trade(string Id, string Customer, string Material, int Qty, string Value, string Status, string StatusStyle);

    List<TopCustomer> TopCustomers = new()
    {
        new("S.M. Infrastructure Pvt Ltd", "Tier 1 Client", "840 MT"),
        new("Akash Buildcon", "Project-based Account", "620 MT"),
        new("Raj Laxmi Steels", "Retail Distributor", "510 MT"),
        new("Bharat TMT Traders", "Wholesale Partner", "480 MT"),
        new("National Steel Corp", "Industrial Supplier", "390 MT"),
    };

    List<StockAlert> FastMoving = new()
    {
        new("12mm TMT Bars (Fe500D)", "Out of Stock Risk: 2 Days", "#ffb4ab", "Critical", "background: #3a1a1a; color: #ffb4ab;"),
        new("8mm HR Sheets (SS304)", "Primary Construction Driver", "#6ee591", "Active", "background: #285233; color: #6ee591;"),
        new("Galvanized Wire (20 Gauge)", "Holding Cost Impact: Low", "#6b726a", "Dead Stock", "background: #2a2e2a; color: #bdcabc;"),
    };

    List<DefaulterEntry> Defaulters = new()
    {
        new("Aggarwal Metals Ltd.", 42, "₹14,20,500"),
        new("Jai Krishna Foundries", 38, "₹8,75,000"),
    };

    List<Trade> Trades = new()
    {
        new("TRD-0291", "S.M. Infrastructure", "12mm TMT Bars", 120, "₹7,44,000", "Delivered", "background: #285233; color: #6ee591;"),
        new("TRD-0290", "Akash Buildcon", "HRC Sheets", 80, "₹6,76,000", "In Transit", "background: #2a3040; color: #90caf9;"),
        new("TRD-0289", "Raj Laxmi Steels", "Scrap Iron HMS-1", 200, "₹7,80,000", "Invoiced", "background: #2e2a1a; color: #ffe082;"),
        new("TRD-0288", "Mehta Construction", "Wire Rod SAE-1008", 50, "₹3,55,000", "Overdue", "background: #3a1a1a; color: #ffb4ab;"),
    };
}
