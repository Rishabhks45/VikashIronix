@inherits LayoutComponentBase
@implements IDisposable
@using VikashIronix_WebUI.Services.Users
@using SharedKernel.DTOs.Users
@inject IUserService UserService

<MudThemeProvider @rendermode="InteractiveServer" Theme="AdminTheme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider @rendermode="InteractiveServer" />
<MudDialogProvider @rendermode="InteractiveServer" />
<MudSnackbarProvider @rendermode="InteractiveServer" />

<MudLayout>
    <MudAppBar Elevation="0" Class="layout-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Class="drawer-toggle-btn" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        
        <div class="search-bar-wrapper">
            <div class="search-bar-container">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" />
                <input type="text" placeholder="Search anything..." class="search-input" />
                <span class="search-shortcut">⌘ K</span>
            </div>
        </div>
        
        <div class="appbar-actions">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="@((e) => _isDarkMode = !_isDarkMode)" />
            
            <div class="notification-badge-container">
                <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
                <span class="notification-badge">3</span>
            </div>

            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2" ActivationEvent="MouseEvent.MouseOver" Dense="true">
                <ActivatorContent>
                    <div class="user-avatar-trigger">
                        @if (!string.IsNullOrEmpty(UserProfilePictureUrl))
                        {
                            <img src="@UserProfilePictureUrl" class="user-avatar-img" alt="Profile" />
                        }
                        else
                        {
                            <MudAvatar Color="Color.Dark" Class="user-avatar">@UserInitials</MudAvatar>
                        }
                        <div class="user-profile-details d-none d-sm-flex">
                            <span class="user-profile-name">@UserName</span>
                            <span class="user-profile-role">@UserRole</span>
                        </div>
                    </div>
                </ActivatorContent>
                <ChildContent>
                    <div class="px-4 py-2 menu-profile-header">
                        <MudText Typo="Typo.subtitle2" Class="menu-profile-username">@UserName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@UserRole</MudText>
                    </div>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/profile" Class="menu-item-text">My Profile</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Settings" Class="menu-item-text">Settings</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" Color="Color.Error" Class="menu-item-text" href="/account/logout">Logout</MudMenuItem>
                </ChildContent>
            </MudMenu>
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" ClipMode="DrawerClipMode.Never" Width="260px" Class="layout-drawer">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-2 mb-2 pt-2 px-3">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code {
    [CascadingParameter] private Task<AuthenticationState> authStateTask { get; set; } = default!;

    private string UserName = "Initializing...";
    private string UserRole = "Staff";
    private string UserInitials = "??";
    private string? UserProfilePictureUrl = null;

    bool _drawerOpen = true;
    bool _isDarkMode = false;

    protected override void OnInitialized()
    {
        UserService.OnProfileUpdated += HandleProfileUpdated;
    }

    private void HandleProfileUpdated(UserDto profile)
    {
        if (profile != null)
        {
            UserProfilePictureUrl = profile.ProfilePictureUrl;
            UserName = $"{profile.FirstName} {profile.LastName}";
            if (!string.IsNullOrEmpty(UserName))
            {
                var parts = UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 1) 
                    UserInitials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                else if (parts.Length > 0)
                    UserInitials = parts[0][0].ToString().ToUpper();
            }
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        UserService.OnProfileUpdated -= HandleProfileUpdated;
    }

    protected override async Task OnParametersSetAsync()
    {
        var authState = await authStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            UserName = user.Identity.Name ?? "System User";
            
            // Try to get role
            UserRole = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Staff";
            
            // Generate initials
            if (!string.IsNullOrEmpty(UserName))
            {
                var parts = UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (parts.Length > 1) 
                    UserInitials = $"{parts[0][0]}{parts[1][0]}".ToUpper();
                else if (parts.Length > 0)
                    UserInitials = parts[0][0].ToString().ToUpper();
            }

            // Fetch user profile picture
            var userIdStr = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(userIdStr, out Guid userId))
            {
                try
                {
                    var profile = await UserService.GetProfileAsync(userId);
                    UserProfilePictureUrl = profile?.ProfilePictureUrl;
                }
                catch
                {
                    UserProfilePictureUrl = null;
                }
            }
        }
    }

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private MudTheme AdminTheme = new()
    {
        PaletteLight = new()
        {
            Primary = "#2563eb",
            Secondary = "#475569",
            AppbarBackground = "#ffffff",
            AppbarText = "#1e293b",
            Background = "#f8fafc",
            Surface = "#ffffff",
            DrawerBackground = "#0b1329",
            DrawerText = "#94a3b8",
            DrawerIcon = "#64748b",
            ActionDefault = "#2563eb",
            TextPrimary = "#0f172a",
            TextSecondary = "#475569",
            Divider = "#e2e8f0",
            Tertiary = "#f59e0b",
            Success = "#10b981",
            Info = "#3b82f6",
            Error = "#ef4444",
            LinesDefault = "#e2e8f0",
            TableLines = "#f1f5f9"
        },
        PaletteDark = new()
        {
            Primary = "#3b82f6",
            Secondary = "#94a3b8",
            AppbarBackground = "#0f172a",
            AppbarText = "#3b82f6",
            Background = "#020617",
            Surface = "#0f172a",
            DrawerBackground = "#020617",
            DrawerText = "#94a3b8",
            DrawerIcon = "#3b82f6",
            ActionDefault = "#3b82f6",
            TextPrimary = "#f8fafc",
            TextSecondary = "#94a3b8",
            Divider = "#1e293b"
        }
    };
}
