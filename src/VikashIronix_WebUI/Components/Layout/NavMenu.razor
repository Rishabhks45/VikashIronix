@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<div class="sidebar-logo-container">
    <MudIcon Icon="@Icons.Material.Filled.Shield" Class="sidebar-logo-icon" />
    <span class="sidebar-logo-title">The Iron Ledger</span>
</div>

<div class="sidebar-menu-wrapper">
    <MudNavMenu Class="sidebar-nav-menu">
        <AuthorizeView Roles="Super Admin,Accountant">
            <div class="sidebar-section-title">EXECUTIVE</div>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Executive Dashboard</MudNavLink>
        </AuthorizeView>
        
        <AuthorizeView Roles="Warehouse Staff">
            <div class="sidebar-section-title">EXECUTIVE</div>
            <MudNavLink Href="/warehouse-dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Logistics Dashboard</MudNavLink>
        </AuthorizeView>
        
        <AuthorizeView Roles="Accountant,Super Admin">
            <Authorized>
                <div class="sidebar-section-title">TRADE OPERATIONS</div>
                <MudNavLink Href="billing/create" Icon="@Icons.Material.Filled.Description">Generate Invoice</MudNavLink>
                <MudNavLink Href="financials/daily" Icon="@Icons.Material.Filled.BarChart">Daily Revenue Audit</MudNavLink>
                <MudNavLink Href="ledger" Icon="@Icons.Material.Filled.MenuBook">Trade Ledger</MudNavLink>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="Accountant,Super Admin,Warehouse Staff">
            <Authorized>
                <div class="sidebar-section-title">CORE MODULES</div>
                <MudNavGroup Title="Logistics Core" Icon="@Icons.Material.Filled.LocalShipping" Expanded="false">
                    <MudNavLink Href="materials" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewList">Material Catalog</MudNavLink>
                    
                    <AuthorizeView Roles="Super Admin" Context="inner">
                        <MudNavLink Href="materials/add" Icon="@Icons.Material.Filled.AddCircle">Material Ingest</MudNavLink>
                        <MudNavLink Href="materials/subcategories" Icon="@Icons.Material.Filled.Hub">Sub-Category Mapping</MudNavLink>
                        <MudNavLink Href="categories/add" Icon="@Icons.Material.Filled.AccountTree">Resource Groups</MudNavLink>
                    </AuthorizeView>
                    
                    <MudNavLink Href="inventory" Icon="@Icons.Material.Filled.Warehouse">Inventory Pulse</MudNavLink>
                </MudNavGroup>
                
                <AuthorizeView Roles="Accountant,Super Admin" Context="inner_ops">
                    <MudNavLink Href="customers" Icon="@Icons.Material.Filled.People">Entity Profiles</MudNavLink>
                    <MudNavLink Href="financials" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance">Fiscal Overview</MudNavLink>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
        
        <AuthorizeView Roles="Super Admin">
            <Authorized>
                <div class="sidebar-section-title">ADMINISTRATION</div>
                <MudNavGroup Title="Administrative Suite" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                    <MudNavLink Href="users" Icon="@Icons.Material.Filled.People">Staff Accounts</MudNavLink>
                    <MudNavLink Href="holidays" Icon="@Icons.Material.Filled.Event">Holiday Calendar</MudNavLink>
                    <MudNavLink Href="salary-configuration" Icon="@Icons.Material.Filled.Payments">Salary Pricing</MudNavLink>
                    <MudNavLink Href="roles" Icon="@Icons.Material.Filled.Security">Privilege Control</MudNavLink>
                    <MudNavLink Href="config" Icon="@Icons.Material.Filled.Settings">System Dynamics</MudNavLink>
                </MudNavGroup>
            </Authorized>
        </AuthorizeView>
    </MudNavMenu>
</div>

<div class="help-card-container">
    <div class="help-card">
        <MudIcon Icon="@Icons.Material.Filled.Help" Class="help-card-icon" />
        <div>
            <span class="help-title">Need Help?</span>
            <div class="help-link-wrapper">
                <a href="/docs" class="help-link">Check our documentation</a>
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="help-link-icon" />
            </div>
        </div>
    </div>
</div>
