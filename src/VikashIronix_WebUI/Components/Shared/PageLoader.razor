@if (IsVisible)
{
    <div class="loader-overlay">
        <div class="loader-content">
            <div class="pulse-container">
                <div class="pulse-ring"></div>
                <div class="pulse-ring-outer"></div>
                <div class="pulse-dot"></div>
            </div>
            @if (!string.IsNullOrEmpty(Text))
            {
                <div class="loader-text">@Text</div>
            }
        </div>
    </div>
}

<style>
    .loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(18, 20, 20, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
    }

    .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
    }

    .pulse-container {
        position: relative;
        width: 80px;
        height: 80px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .pulse-dot {
        width: 24px;
        height: 24px;
        background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
        border-radius: 50%;
        box-shadow: 0 0 20px rgba(124, 58, 237, 0.6);
        z-index: 2;
    }

    .pulse-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: rgba(124, 58, 237, 0.25);
        animation: loaderPulse 2s infinite cubic-bezier(0.215, 0.610, 0.355, 1);
        z-index: 1;
    }

    .pulse-ring-outer {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background-color: rgba(99, 102, 241, 0.15);
        animation: loaderPulse 2s infinite cubic-bezier(0.215, 0.610, 0.355, 1);
        animation-delay: 0.6s;
        z-index: 1;
    }

    @@keyframes loaderPulse {
        0% {
            transform: scale(0.2);
            opacity: 1;
        }
        100% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    .loader-text {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #e5e7eb;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        animation: textFade 1.5s infinite alternate;
    }

    @@keyframes textFade {
        0% {
            opacity: 0.5;
        }
        100% {
            opacity: 1;
        }
    }
</style>

@code {
    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public string Text { get; set; } = "Establishing Secure Session...";
}
